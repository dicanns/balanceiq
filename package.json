{
  "name": "balanceiq",
  "version": "1.40.58",
  "description": "L'intelligence derrière vos chiffres.",
  "main": "main.js",
  "scripts": {
    "prestart": "npx @electron/rebuild -f -w better-sqlite3",
    "start": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "vite": "vite",
    "electron": "electron .",
    "build": "vite build && electron-builder --mac && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:win": "electron-builder --win",
    "rebuild": "npx @electron/rebuild -f -w better-sqlite3",
    "pretest": "npm rebuild better-sqlite3 --quiet",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npx @electron/rebuild -f -w better-sqlite3",
    "test:e2e": "playwright test --project=electron",
    "stress-test": "bash scripts/stress-test.sh",
    "test:chaos": "npm rebuild better-sqlite3 --quiet && vitest run src/__tests__/chaos/userBehavior.test.js",
    "test:backup-parity": "npm rebuild better-sqlite3 --quiet && vitest run src/__tests__/safety/backupSchemaParity.test.js",
    "check:edge-auth": "bash scripts/check-edge-function-auth.sh",
    "audit": "npm audit --production --audit-level=critical",
    "scan:semgrep": "semgrep --config .semgrep.yml src/"
  },
  "dependencies": {
    "@sentry/electron": "^7.10.0",
    "@supabase/supabase-js": "^2.99.0",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.3",
    "pdfjs-dist": "^2.16.105",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.1",
    "concurrently": "^8.2.2",
    "dotenv": "^17.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^10.2.1",
    "eslint-plugin-security": "^4.0.0",
    "playwright": "^1.58.2",
    "vite": "^5.3.5",
    "vitest": "^4.1.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.balanceiq.app",
    "productName": "BalanceIQ",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/pdfjs-dist/**/*"
    ],
    "files": [
      "**/*",
      "!node_modules/**/better-sqlite3/build/Release/.deps/**"
    ],
    "extraResources": [],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "target": "dmg",
      "identity": "Exxdon The Hamburger Company Inc (462N375L9T)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": {
        "teamId": "462N375L9T"
      }
    },
    "dmg": {
      "title": "BalanceIQ ${version}",
      "backgroundColor": "#0c0e14",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "asarUnpack": [
        "node_modules/better-sqlite3/**/*",
        "node_modules/pdfjs-dist/**/*",
        "**/*.node"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BalanceIQ"
    },
    "publish": {
      "provider": "github",
      "owner": "dicanns",
      "repo": "balanceiq"
    }
  }
}
